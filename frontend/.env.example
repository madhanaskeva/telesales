# Where the dev server proxies /api (the Express backend in ../backend)
VITE_BACKEND_URL=http://localhost:5000

# API base used by the browser. Keep /api in development (goes through the Vite proxy).
# For a build hosted away from the backend, set the full URL, e.g. https://telesales.askeva.io/api
VITE_API_BASE=/api

# Optional second API base tried when the first cannot be reached
# VITE_API_FALLBACK=http://localhost:5000/api
